# ─────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME="Washermann API"
FRONTEND_URL=http://localhost:3001

# ─────────────────────────────────────────────
# DATABASE (Neon / PostgreSQL)
# ─────────────────────────────────────────────
# Option A — Full URL (Railway, Neon, Supabase). Takes precedence when set.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option B — Individual params (local Docker dev)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=washermann
DB_SSL=false
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_MIGRATIONS_RUN=true

# ─────────────────────────────────────────────
# REDIS (Upstash or local)
# ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
# Override with full Upstash URL in production:
# REDIS_URL=rediss://:password@host:port

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-strong-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-another-strong-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_PASSWORD_EXPIRES_IN=1h
JWT_INVITE_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# PAYSTACK
# ─────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxx
PAYSTACK_WEBHOOK_SECRET=paystack-webhook-secret

# ─────────────────────────────────────────────
# RESEND (Email)
# ─────────────────────────────────────────────
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=no-reply@washermann.com
RESEND_FROM_NAME="Washermann"

# ─────────────────────────────────────────────
# TERMII (SMS)
# ─────────────────────────────────────────────
TERMII_API_KEY=xxxx
TERMII_SENDER_ID=Washermann

# ─────────────────────────────────────────────
# FIREBASE (Push Notifications)
# ─────────────────────────────────────────────
FIREBASE_PROJECT_ID=washermann
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@washermann.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# ─────────────────────────────────────────────
# CLOUDFLARE R2 (Storage)
# ─────────────────────────────────────────────
R2_ACCOUNT_ID=xxxx
R2_ACCESS_KEY_ID=xxxx
R2_SECRET_ACCESS_KEY=xxxx
R2_BUCKET_NAME=washermann
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ─────────────────────────────────────────────
# PLATFORM SETTINGS
# ─────────────────────────────────────────────
WASH_POINT_CONVERSION_RATE=1
ORDER_AUTO_CONFIRM_HOURS=24
VENDOR_RESPONSE_TIMEOUT_MINUTES=30
INACTIVITY_THRESHOLD_DAYS=90
WALLET_CONVERSION_SECRET=replace-with-strong-hmac-secret

# One-time secret for POST /auth/setup (production first-run admin creation)
ADMIN_SETUP_SECRET=replace-with-strong-setup-secret

# ─────────────────────────────────────────────
# SEED (dev/staging only — auto-creates super admin on boot)
# ─────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@washermann.com
SEED_ADMIN_PASSWORD=Admin@1234
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PHONE=

# ─────────────────────────────────────────────
# DEEP LINK
# ─────────────────────────────────────────────
# Mobile app deep link base for invite URLs
DEEP_LINK_BASE=washermann://app

# ─────────────────────────────────────────────
# SENTRY
# ─────────────────────────────────────────────
SENTRY_DSN=https://xxxx@sentry.io/xxxx
