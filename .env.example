# ─────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME="Washermann API"
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# ─────────────────────────────────────────────
# DATABASE (Neon / PostgreSQL)
# ─────────────────────────────────────────────
# Option A — Full URL (Railway, Neon, Supabase). Takes precedence when set.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option B — Individual params (local Docker dev)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=washermann
DB_SSL=false
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_MIGRATIONS_RUN=true

# ─────────────────────────────────────────────
# REDIS (Upstash or local)
# ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
# Override with full Upstash URL in production:
# REDIS_URL=rediss://:password@host:port

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-strong-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-another-strong-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_PASSWORD_EXPIRES_IN=1h
JWT_INVITE_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# PAYSTACK
# ─────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxx
PAYSTACK_WEBHOOK_SECRET=paystack-webhook-secret
# Top-up limits in kobo (100 kobo = ₦1). Defaults: ₦100 min, ₦500,000 max.
MIN_TOPUP_KOBO=10000
MAX_TOPUP_KOBO=50000000

# ─────────────────────────────────────────────
# TOP-UP SECURITY (Anti-manipulation HMAC gate)
# ─────────────────────────────────────────────
# Server-side secret used to derive per-user topupKey: HMAC-SHA256(signingSecret, userId)
# The topupKey is returned at login and stored by the mobile app.
TOPUP_SIGNING_SECRET=replace-with-strong-secret-min-32-chars

# Client-side secret baked into the mobile app binary.
# Used to generate the time-based HMAC topup code:  HMAC-SHA256(clientSecret, "{userId}:{topupKey}:{window}")
TOPUP_CLIENT_APP_SECRET=replace-with-different-strong-secret-min-32-chars

# Time window size in seconds for topup code validity (default 30 — codes valid for ±1 window = ±30 s)
TOPUP_CODE_WINDOW_SECONDS=30

# ─────────────────────────────────────────────
# CONVERSION RATE SECURITY (Admin gate)
# ─────────────────────────────────────────────
# The question admins must answer before changing the WashPoint conversion rate.
RATE_CHANGE_SECURITY_QUESTION="What is the Washermann platform master passphrase?"

# bcrypt hash of the correct answer (lowercase, trimmed).
# Generate with: node -e "const bcrypt = require('bcrypt'); bcrypt.hash('youranswer', 12).then(console.log)"
RATE_CHANGE_SECURITY_ANSWER_HASH=$2b$12$replace-this-with-real-bcrypt-hash 
# (HolyRosaryCollege)
# Minutes after creation before a new rate becomes active (default 60).
# Prevents manipulation: attacker who changes rate must wait before benefiting.
RATE_CHANGE_EFFECTIVE_DELAY_MINUTES=60

# ─────────────────────────────────────────────
# RESEND (Email)
# ─────────────────────────────────────────────
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=no-reply@washermann.com
RESEND_FROM_NAME="Washermann"
# Absolute URL of the white-wordmark PNG shown in email headers.
# Must be publicly hosted (clients can't load local files/SVG). Empty → text wordmark.
EMAIL_LOGO_URL=https://washermann.com/email-logo.png

# ─────────────────────────────────────────────
# TERMII (SMS)
# ─────────────────────────────────────────────
TERMII_API_KEY=xxxx
TERMII_SENDER_ID=Washermann

# ─────────────────────────────────────────────
# FIREBASE (Push Notifications)
# ─────────────────────────────────────────────
FIREBASE_PROJECT_ID=washermann
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@washermann.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# ─────────────────────────────────────────────
# CLOUDFLARE R2 (Storage)
# ─────────────────────────────────────────────
R2_ACCOUNT_ID=xxxx
R2_ACCESS_KEY_ID=xxxx
R2_SECRET_ACCESS_KEY=xxxx
R2_BUCKET_NAME=washermann
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ─────────────────────────────────────────────
# PLATFORM SETTINGS
# ─────────────────────────────────────────────
WASH_POINT_CONVERSION_RATE=1
ORDER_AUTO_CONFIRM_HOURS=24
VENDOR_RESPONSE_TIMEOUT_MINUTES=30
INACTIVITY_THRESHOLD_DAYS=90
WALLET_CONVERSION_SECRET=replace-with-strong-hmac-secret

# One-time secret for POST /auth/setup (production first-run admin creation)
ADMIN_SETUP_SECRET=replace-with-strong-setup-secret

# ─────────────────────────────────────────────
# SEED (dev/staging only — auto-creates super admin on boot)
# ─────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@washermann.com
SEED_ADMIN_PASSWORD=Admin@1234
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PHONE=

# ─────────────────────────────────────────────
# DEEP LINK
# ─────────────────────────────────────────────
# Mobile app deep link base for invite URLs
DEEP_LINK_BASE=washermann://app

# ─────────────────────────────────────────────
# SENTRY
# ─────────────────────────────────────────────
SENTRY_DSN=https://xxxx@sentry.io/xxxx

# The maximum number of vendors to broadcast a new order assignment to when looking for a washer (default 3).
ASSIGNMENT_BROADCAST_N=3

# Seconds after which a pending assignment expires and the next vendor(s) are broadcasted (default 90).
ASSIGNMENT_WINDOW_SECONDS=90

# Days window after which a vendor can update their pricing again (default 90).
VENDOR_PRICING_COOLDOWN_DAYS=90

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=washermann        # optional, defaults to "washermann"
