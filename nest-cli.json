{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": ["@nestjs/swagger"],
    "assets": [
      { "include": "database/seeds/policy-docx/**/*", "outDir": "dist", "watchAssets": true },
      { "include": "modules/receipts/assets/**/*", "outDir": "dist", "watchAssets": true }
    ],
    "watchAssets": true
  }
}
