    {
      "name": "Wallets",
      "description": "WashPoint wallet balance, transaction ledger, top-up flows and admin manual adjustments.\n\n**Top-up flow:**\n1. `POST /wallets/me/topup` → returns Paystack `authorizationUrl` + `reference`\n2. User completes payment in browser/WebView\n3. Paystack fires webhook → wallet credited automatically\n4. `GET /wallets/me/topup/:reference` as fallback verification\n\n**X-WM-Topup-Code header:** A time-based HMAC code generated by the mobile app each time a top-up is initiated. It is derived from `topupKey` (returned at login), `userId`, and the current time window — preventing replay attacks.",
      "item": [
        {
          "name": "— Self —",
          "item": [
            {
              "name": "Get My Wallet",
              "request": {
                "method": "GET",
                "header": [],
                "url": { "raw": "{{baseUrl}}/wallets/me", "host": ["{{baseUrl}}"], "path": ["wallets", "me"] },
                "description": "Get authenticated user's WashPoint balance and total fiat spent (sum of all successful Paystack transactions)."
              },
              "response": []
            },
            {
              "name": "Get My Ledger",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/wallets/me/ledger?page=1&limit=20",
                  "host": ["{{baseUrl}}"],
                  "path": ["wallets", "me", "ledger"],
                  "query": [
                    { "key": "page",  "value": "1" },
                    { "key": "limit", "value": "20" }
                  ]
                },
                "description": "Paginated WashPoint transaction history. Each entry shows type (credit/debit), amount, running balance, source (topup, order_payment, etc.), and the conversion rate snapshot used."
              },
              "response": []
            },
            {
              "name": "Initiate Top-up",
              "event": [{
                "listen": "test",
                "script": {
                  "exec": [
                    "if (pm.response.code === 201) {",
                    "  const res = pm.response.json();",
                    "  if (res.data && res.data.reference) {",
                    "    pm.collectionVariables.set('paymentReference', res.data.reference);",
                    "    pm.test('Reference saved', () => pm.expect(res.data.reference).to.be.a('string'));",
                    "  }",
                    "  pm.test('Authorization URL present', () => pm.expect(res.data.authorizationUrl).to.include('paystack'));",
                    "}"
                  ],
                  "type": "text/javascript"
                }
              }],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type",    "value": "application/json" },
                  { "key": "X-WM-Topup-Code", "value": "REPLACE_WITH_APP_GENERATED_CODE", "description": "Time-based HMAC code generated by mobile app from topupKey. In dev mode (env vars unset) any value is accepted." }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amountNaira\": 5000,\n  \"currency\": \"NGN\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/wallets/me/topup", "host": ["{{baseUrl}}"], "path": ["wallets", "me", "topup"] },
                "description": "Initiate a WashPoints top-up via Paystack. Returns `authorizationUrl` (open in browser/WebView), `reference`, `washPointsPreview` and `conversionRate`. The `X-WM-Topup-Code` header is required and must be a valid HMAC code derived from `topupKey`. Auto-saves `paymentReference` variable."
              },
              "response": []
            },
            {
              "name": "Verify Top-up (Mobile Fallback)",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/wallets/me/topup/{{paymentReference}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["wallets", "me", "topup", "{{paymentReference}}"]
                },
                "description": "Poll payment status for a specific reference. Used as a fallback when the webhook is delayed. If the payment is successful and not yet credited, credits the wallet now."
              },
              "response": []
            }
          ]
        },
        {
          "name": "— Admin —",
          "item": [
            {
              "name": "[Admin] View User Wallet",
              "request": {
                "method": "GET",
                "header": [],
