    {
      "name": "Conversion Rates",
      "description": "WashPoint ↔ fiat conversion rate management.\n\n**How rates work:**\n- Rates are append-only (no edits, no deletes).\n- A new rate becomes **active after a configurable delay** (default 60 min) — this prevents an attacker from spiking the rate just before a top-up.\n- The rate is **locked at top-up initiation** and stored in the transaction — the webhook uses the snapshot, not the live rate.\n- Changing the rate requires answering a **security question** (bcrypt-verified). Use `GET /conversion-rates/challenge` to fetch the question first.",
      "item": [
        {
          "name": "Get Active Rate",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversion-rates/active?currency=NGN",
              "host": ["{{baseUrl}}"],
              "path": ["conversion-rates", "active"],
              "query": [{ "key": "currency", "value": "NGN", "description": "ISO 4217 currency code (e.g. NGN). Optional — returns all active rates when omitted." }]
            },
            "description": "**Public.** Get the currently active conversion rate for a currency. Returns the most recent rate where `effective_from <= NOW()`. Rate tells you how many WashPoints 1 Naira buys (`pointsPerUnit`)."
          },
          "response": []
        },
        {
          "name": "Get Rate History",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversion-rates?currency=NGN",
              "host": ["{{baseUrl}}"],
              "path": ["conversion-rates"],
              "query": [{ "key": "currency", "value": "NGN", "description": "Optional filter. Omit to get history for all currencies." }]
            },
            "description": "**Public.** Full history of all conversion rates (including future-effective ones). Ordered by `effective_from` DESC."
          },
          "response": []
        },
        {
          "name": "[Admin] Get Security Challenge",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/conversion-rates/challenge", "host": ["{{baseUrl}}"], "path": ["conversion-rates", "challenge"] },
            "description": "[Admin only] Retrieve the security question that must be answered before a rate change can be submitted. The answer is bcrypt-verified server-side."
          },
          "response": []
        },
        {
          "name": "[Admin] Set New Rate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"NGN\",\n  \"pointsPerUnit\": 10,\n  \"securityAnswer\": \"your answer here\",\n  \"notes\": \"Q2 2026 rate adjustment\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/conversion-rates", "host": ["{{baseUrl}}"], "path": ["conversion-rates"] },
            "description": "[Admin only] Set a new conversion rate. `pointsPerUnit` = WashPoints awarded per 1 Naira (e.g. 10 means ₦1 = 10 WP). Requires the correct `securityAnswer`. The new rate becomes active after the configured delay (default 60 min, see `RATE_CHANGE_EFFECTIVE_DELAY_MINUTES` in .env)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Webhooks (Dev Testing)",
      "description": "Paystack webhook receiver. In production these are called by Paystack, not manually.\n\n**Signature:** Paystack signs the raw JSON body with HMAC-SHA512 using your `PAYSTACK_WEBHOOK_SECRET`. The signature is in the `x-paystack-signature` header.\n\n**Important:** Always returns HTTP 200 even on errors — returning non-2xx causes Paystack to retry, which can cause duplicate processing.\n\n**For local testing:** Use the Paystack dashboard test webhooks feature, or a tool like Ngrok to expose your local server.",
      "item": [
        {
          "name": "Paystack Webhook (charge.success)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type",         "value": "application/json" },
              { "key": "x-paystack-signature",  "value": "REPLACE_WITH_VALID_HMAC_SHA512", "description": "HMAC-SHA512 of raw body signed with PAYSTACK_WEBHOOK_SECRET. In dev, the server logs a warning and processes it anyway if the secret is not set." }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"charge.success\",\n  \"data\": {\n    \"reference\": \"{{paymentReference}}\",\n    \"status\": \"success\",\n    \"amount\": 500000,\n    \"currency\": \"NGN\",\n    \"channel\": \"card\",\n    \"paid_at\": \"2026-04-20T12:00:00.000Z\",\n    \"customer\": { \"email\": \"john@example.com\" }\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/webhooks/paystack", "host": ["{{baseUrl}}"], "path": ["webhooks", "paystack"] },
            "description": "Simulate a Paystack `charge.success` webhook. Replace `{{paymentReference}}` with a real reference from a PENDING transaction. **Requires a valid HMAC-SHA512 signature in production.** Always returns `{ received: true }`."
          },
          "response": []
        },
        {
          "name": "Paystack Webhook (charge.failed)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type",         "value": "application/json" },
              { "key": "x-paystack-signature",  "value": "REPLACE_WITH_VALID_HMAC_SHA512" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"charge.failed\",\n  \"data\": {\n    \"reference\": \"{{paymentReference}}\",\n    \"status\": \"failed\",\n    \"amount\": 500000,\n    \"currency\": \"NGN\",\n    \"channel\": \"card\",\n    \"customer\": { \"email\": \"john@example.com\" }\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/webhooks/paystack", "host": ["{{baseUrl}}"], "path": ["webhooks", "paystack"] },
            "description": "Simulate a Paystack `charge.failed` webhook. Marks the transaction as FAILED. Always returns `{ received: true }`."
          },
          "response": []
        }
      ]
    }
  ]
