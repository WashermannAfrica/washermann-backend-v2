              "path": ["users", "me", "addresses", ":id", "default"],
              "variable": [{ "key": "id", "value": "address-uuid-here" }]
            },
            "description": "Set an address as the default delivery address."
          },
          "response": []
        },
        {
          "name": "[Admin] List All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "[Admin only] List all users with pagination."
          },
          "response": []
        },
        {
          "name": "[Admin] Get User By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/:id",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":id"],
              "variable": [{ "key": "id", "value": "user-uuid-here" }]
            },
            "description": "[Admin only] Get any user by their UUID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Companies",
      "description": "Company management, tiers, employee assignments and admin grants. Company-scoped endpoints require either Role.ADMIN (platform admin) or Role.COMPANY_ADMIN for that specific company.",
      "item": [
        {
          "name": "— Company CRUD (Admin only) —",
          "item": [
            {
              "name": "[Admin] Create Company",
              "event": [{
                "listen": "test",
                "script": {
                  "exec": [
                    "if (pm.response.code === 201) {",
                    "  const res = pm.response.json();",
                    "  pm.collectionVariables.set('companyId', res.data.id);",
                    "  pm.test('Company created', () => pm.expect(res.success).to.be.true);",
                    "}"
                  ],
                  "type": "text/javascript"
                }
              }],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Acme Corp\",\n  \"contactEmail\": \"hr@acme.com\",\n  \"contactPhone\": \"+2348012345678\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/companies", "host": ["{{baseUrl}}"], "path": ["companies"] },
                "description": "[Admin only] Create a new company on the platform. Auto-saves the returned ID as `companyId` collection variable."
              },
              "response": []
            },
            {
              "name": "[Admin] List Companies",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/companies?page=1&limit=20",
                  "host": ["{{baseUrl}}"],
                  "path": ["companies"],
                  "query": [
                    { "key": "page", "value": "1" },
                    { "key": "limit", "value": "20" }
                  ]
                },
                "description": "[Admin only] Paginated list of all companies on the platform."
              },
              "response": []
            },
            {
              "name": "Get Company",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/companies/{{companyId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["companies", "{{companyId}}"]
